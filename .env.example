PORT=5173                      # 로컬 웹 서버 포트

# ── Daytona — 미래 머지 상태를 격리 실행 ──
DAYTONA_API_KEY=               # Daytona API 키
DAYTONA_API_URL=               # Daytona API 주소 (기본값 https://app.daytona.io/api)
DAYTONA_SNAPSHOT=              # 선택: node/npm 캐시를 구운 스냅샷, 부팅 시간 단축

# ── Nosana — 충돌 가설과 상호작용 테스트 생성 ──
LLM_ENDPOINT=                  # OpenAI 호환 /chat/completions 주소 (예: https://<nosana-배포>/v1)
LLM_MODEL=                     # 모델 이름 (예: qwen3.5:9b)
LLM_API_KEY=                   # 선택: 배포가 인증을 요구할 때만
NOSANA_API_KEY=                # 크레딧 잔액 조회용

# ── GitHub ──
GITHUB_TOKEN=                  # PR 메타데이터 조회, CI 에서는 Actions 가 자동 주입

# ── 리포트 링크 ──
PUBLIC_BASE_URL=               # 선택: PR 코멘트에 넣을 리포트 URL 의 호스트
