# cp .env.example .env 후 채우기.
# 전부 채웠으면 `npm run preflight` 로 한 번에 검증하세요 (PREP.md 참고).

PORT=5173

# Anthropic — 앱 코드 생성 (claude-opus-5)
ANTHROPIC_API_KEY=

# Daytona — 샌드박스 실행
DAYTONA_API_KEY=
# 선택: 미리 구워둔 스냅샷 ID (부팅 시간이 확 줄어듭니다 — 전날 준비 권장)
DAYTONA_SNAPSHOT=

# DNSimple — 도메인/DNS
DNSIMPLE_TOKEN=
DNSIMPLE_ACCOUNT_ID=          # npm run preflight 가 알려줍니다
DNSIMPLE_ZONE=내도메인.com

# VPS 라우터 (Caddy 뒤에서 도는 router/index.js)
VPS_IP=
ROUTER_URL=https://ship.내도메인.com
ROUTER_SECRET=                # 아무 랜덤 문자열 (라우터와 동일하게)

# Nosana — 오픈모델로 생성 앱 검수
# ⚠️ OpenAI 호환 /chat/completions 를 가정합니다. 전날 반드시 실제로 호출해보세요.
NOSANA_API_KEY=
NOSANA_ENDPOINT=
NOSANA_MODEL=
