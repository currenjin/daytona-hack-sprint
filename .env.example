PORT=5173

# ── Daytona — 미래 머지 상태를 격리 실행 ──
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=              # 선택: node/npm 캐시를 구운 스냅샷 (부팅 단축)

# ── Nosana — 충돌 가설 + 상호작용 테스트 생성 ──
# OpenAI 호환 /chat/completions 엔드포인트
LLM_ENDPOINT=                  # 예: https://<nosana-배포>/v1
LLM_MODEL=
LLM_API_KEY=


# ── DNSimple — 충돌 리포트 주소 ──
DNSIMPLE_TOKEN=
DNSIMPLE_ACCOUNT_ID=
DNSIMPLE_ZONE=
VPS_IP=
ROUTER_URL=
ROUTER_SECRET=
