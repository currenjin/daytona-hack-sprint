# cp .env.example .env 후 채우기.
# 전부 채웠으면 `npm run preflight` 로 한 번에 검증하세요 (PREP.md 참고).

PORT=5173

# ── 생성 엔진 ────────────────────────────────────────────────
# OpenAI 호환 /chat/completions 를 제공하는 엔드포인트면 무엇이든 됩니다.
#
#   Nosana  — vLLM/Ollama 컨테이너를 GPU에 배포하고 노출된 URL을 씁니다 (참가자 크레딧 사용)
#             LLM_ENDPOINT=https://<배포-주소>/v1
#   로컬    — 오늘 공짜로 테스트할 때. `ollama serve` 후:
#             LLM_ENDPOINT=http://localhost:11434/v1
#             LLM_MODEL=qwen2.5-coder:7b
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# (선택) Anthropic 키가 있다면 이걸 대신 씁니다. LLM_ENDPOINT 가 우선입니다.
ANTHROPIC_API_KEY=

# ── Daytona — 격리 실행 + 검증 무대 ──────────────────────────
DAYTONA_API_KEY=
# 선택: jsdom을 미리 구워둔 스냅샷 ID. 데모 때 설치 시간을 아낍니다.
DAYTONA_SNAPSHOT=

# ── DNSimple — 실제 도메인 ───────────────────────────────────
DNSIMPLE_TOKEN=
DNSIMPLE_ACCOUNT_ID=          # npm run preflight 가 알려줍니다
DNSIMPLE_ZONE=내도메인.com

# VPS 라우터 (Caddy 뒤에서 도는 router/index.js)
VPS_IP=
ROUTER_URL=https://ship.내도메인.com
ROUTER_SECRET=                # 아무 랜덤 문자열 (라우터와 동일하게)
