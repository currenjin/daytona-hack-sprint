# VPS: /etc/caddy/Caddyfile
#
# 전날 밤에 띄워두고 와일드카드 인증서를 미리 받아둘 것.
# xcaddy build --with github.com/caddy-dns/dnsimple  로 빌드한 바이너리 필요.
#
# 환경변수: DNSIMPLE_API_ACCESS_TOKEN (Account token이면 account_id 생략 가능)

*.ship.내도메인.com {
	tls {
		dns dnsimple {$DNSIMPLE_API_ACCESS_TOKEN}
	}

	# 모든 서브도메인을 로컬 라우터로. 라우터가 Host 헤더로 분기한다.
	reverse_proxy localhost:8080 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
	}
}

# 라우터 등록 API도 같은 인증서로 노출 (로컬 노트북에서 호출)
ship.내도메인.com {
	tls {
		dns dnsimple {$DNSIMPLE_API_ACCESS_TOKEN}
	}
	reverse_proxy localhost:8080
}
